{
  "version": "0.0.0",
  "tasks": {
    "dev": "deno run -A --watch bootstrap/app.ts",
    "build": "deno compile -A --include app/worker/worker.ts --output .outputs/app bootstrap/app.ts",
    "start": "./.outputs/app",
    "db:migrate": "deno run -A bootstrap/migrator.ts migrate -c ./database/nessie.mysql.config.ts"
  },
  "imports": {
    "@/": "./",
    "@/cache-manager": "./modules/cache-manager/index.ts",
    "@paolostyle/hono-zod-openapi": "jsr:@paolostyle/hono-zod-openapi@^0.5.0",
    "@scalar/hono-api-reference": "npm:@scalar/hono-api-reference@^0.5.165",
    "@std/assert": "jsr:@std/assert@1",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.3",
    "@std/uuid": "jsr:@std/uuid@^1.0.4",
    "hono": "jsr:@hono/hono@^4.6.15",
    "hono-openapi": "npm:hono-openapi@^0.3.1",
    "mysql": "https://deno.land/x/mysql@v2.12.1/mod.ts",
    "nessie": "https://deno.land/x/nessie@2.0.11/mod.ts",
    "nessie-cli": "https://deno.land/x/nessie@2.0.11/cli.ts",
    "rxjs": "npm:rxjs@^7.8.1",
    "zod": "npm:zod@^3.24.1",
    "zod-openapi": "npm:zod-openapi@^4.2.2"
  },
  "fmt": {
    "indentWidth": 4,
    "lineWidth": 120,
    "semiColons": false,
    "singleQuote": true,
    "useTabs": false
  },
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  }
}
